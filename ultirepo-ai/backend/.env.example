# --- LLM / embedding provider keys ---
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Provider selection ---
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- RAG tuning ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
DEFAULT_TOP_K=6
MAX_CONTEXT_CHARS=12000

# --- Storage paths (relative to backend/) ---
CHROMA_PERSIST_DIR=storage/chroma
REPO_CLONE_DIR=storage/repos
HISTORY_DB_PATH=storage/history.sqlite3

# --- Server ---
MAX_REPO_SIZE_MB=500
